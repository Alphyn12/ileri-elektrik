{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    { "source": "/index.php", "has": [{ "type": "query", "key": "icerik", "value": "49" }], "destination": "/hakkimizda/", "permanent": true },
    { "source": "/index.php", "has": [{ "type": "query", "key": "icerik", "value": "50" }], "destination": "/hizmetlerimiz/", "permanent": true },
    { "source": "/index.php", "has": [{ "type": "query", "key": "icerik", "value": "76" }], "destination": "/hizmetlerimiz/", "permanent": true },
    { "source": "/index.php", "has": [{ "type": "query", "key": "icerik", "value": "89" }], "destination": "/hizmetlerimiz/", "permanent": true },
    { "source": "/index.php", "has": [{ "type": "query", "key": "icerik", "value": "52" }], "destination": "/iletisim/", "permanent": true },
    { "source": "/index.php", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
