---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactBar from '../components/ContactBar.astro';
import { business } from '../data/site';
import ogDefault from '../assets/katalog/ic-02.jpg';
import { getImage } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  /** Anasayfa: tam ekran slayt; header şeffaf, footer yok. */
  home?: boolean;
  schema?: Record<string, unknown>[];
  ogImage?: ImageMetadata;
  noindex?: boolean;
}

const { title, description, home = false, schema = [], ogImage = ogDefault, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = await getImage({ src: ogImage, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site).href;

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': ['HomeGoodsStore', 'HardwareStore'],
  '@id': `${business.url}/#isletme`,
  name: business.brand,
  alternateName: business.name,
  description:
    'Denizli Pamukkale’de 1997’den beri avize, aydınlatma ve elektrik malzemesi satışı ve elektrik taahhüt işleri.',
  url: business.url + '/',
  image: ogUrl,
  telephone: business.phones[0].tel,
  email: business.email,
  foundingDate: String(business.founded),
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address.street,
    addressLocality: business.address.district,
    addressRegion: business.address.city,
    postalCode: business.address.postalCode,
    addressCountry: business.address.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: business.geo.lat, longitude: business.geo.lng },
  openingHoursSpecification: business.hours
    .filter((h) => h.open)
    .map((h) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: h.schemaDays, opens: h.open, closes: h.close })),
  areaServed: { '@type': 'City', name: 'Denizli' },
  hasMap: business.googleMapsUrl,
  sameAs: [business.googleMapsUrl, business.instagram],
  paymentAccepted: 'Nakit, Kredi kartı, Banka kartı',
};
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#171412" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content={business.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body class:list={{ home }}>
    <a class="skip" href="#icerik">İçeriğe geç</a>
    <Header overlay={home} />
    <main id="icerik">
      <slot />
    </main>
    {!home && <Footer />}
    <ContactBar />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    padding: 0.6rem 1rem;
    background: var(--copper);
    color: var(--bg-deep);
    border-radius: var(--radius);
    font-weight: 600;
  }
  .skip:focus {
    top: 1rem;
  }
</style>
