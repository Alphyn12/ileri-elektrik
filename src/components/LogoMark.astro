---
// İleri Elektrik logosu: bakır kare içinde kıvrılan tek çizgi "E" harfini çiziyor.
// Çizginin iki ucu, sol kenarda dikey yazılan İLERİ kelimesinin İ harflerine denk geliyor.
// Çizgiler kesik (zemin rengi) görünür; zemin rengi --logo-cut ile ayarlanır.
interface Props {
  class?: string;
  title?: string;
}
const { class: cls, title } = Astro.props;
---

<svg
  class={cls}
  viewBox="0 0 100 100"
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
  focusable="false"
>
  <rect width="100" height="100" fill="var(--logo-copper, #c3834f)"></rect>
  <g fill="none" stroke="var(--logo-cut, #171412)" stroke-linejoin="miter" stroke-linecap="butt">
    <path class="line" pathLength="1" stroke-width="3.4" d="M29 10.5H91V26.3H44V42.1H91V57.9H44V73.7H91V89.5H29"></path>
    <g transform="translate(0 100) rotate(-90)" stroke-width="2.3">
      <path d="M10.5 13V24M25 13V24H31M51 13H45V24H51M45 18.5H50M64 24V13H67.5A2.75 2.75 0 0 1 67.5 18.5H64M67 18.5L70.5 24M89.5 13V24"></path>
      <circle cx="10.5" cy="9.4" r="1.3" fill="var(--logo-cut, #171412)" stroke="none"></circle>
      <circle cx="89.5" cy="9.4" r="1.3" fill="var(--logo-cut, #171412)" stroke="none"></circle>
    </g>
  </g>
</svg>
