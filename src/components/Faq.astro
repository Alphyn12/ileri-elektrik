---
interface Props {
  items: { q: string; a: string }[];
  heading?: string;
}
const { items, heading = 'Sık sorulan sorular' } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
};
---

<section class="section faq" aria-labelledby="sss">
  <div class="wrap grid">
    <h2 id="sss">{heading}</h2>
    <div class="items">
      {
        items.map((i) => (
          <details>
            <summary>{i.q}</summary>
            <p>{i.a}</p>
          </details>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>

<style>
  .faq {
    background: var(--bg-raised);
  }
  .grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 2rem 4rem;
    align-items: start;
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  details:first-child {
    border-top: 1px solid var(--line);
  }
  summary {
    position: relative;
    padding: 1.15rem 2.5rem 1.15rem 0;
    font-weight: 600;
    font-size: 1.08rem;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '';
    position: absolute;
    right: 0.4rem;
    top: 50%;
    width: 0.65rem;
    height: 0.65rem;
    border-right: 2px solid var(--text);
    border-bottom: 2px solid var(--text);
    translate: 0 -70%;
    rotate: 45deg;
    transition: rotate 0.2s ease, translate 0.2s ease;
  }
  details[open] summary::after {
    rotate: 225deg;
    translate: 0 -30%;
  }
  details p {
    padding: 0 2.5rem 1.3rem 0;
    color: var(--text-soft);
    max-width: 40em;
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
